#!/bin/bash
# ============================================================
# fnmonitor 安装后置处理
# 1) 创建桌面 UI 软链接（fnOS 不会自动把 ui 解压到应用基础目录）
# 2) 初始化数据目录与默认配置
# 3) 确保脚本可执行权限
# ============================================================
APP_NAME="${TRIM_APPNAME:-fnmonitor}"
APP_DEST="${TRIM_APPDEST}"

# 应用基础目录随安装位置不同（/var/apps、/volN/@appcenter、/usr/local/apps/@appcenter…），不能写死
resolve_bases() {
    local d
    for d in "/var/apps/${APP_NAME}" "/usr/local/apps/@appcenter/${APP_NAME}" \
             "/usr/trim/apps/${APP_NAME}" "/var/lib/fnos/apps/${APP_NAME}" \
             /vol*/@appcenter/"${APP_NAME}"; do
        if [ -f "$d/manifest" ] || [ -d "$d/cmd" ]; then
            echo "$d"
        fi
    done
}
BASES="$(resolve_bases)"
if [ -z "$BASES" ] && [ -n "$APP_DEST" ]; then
    BASES="${APP_DEST%/}"
fi

# 1. UI 软链接（缺了它桌面图标不会出现）
for APP_BASE in $BASES; do
    if [ -d "${APP_DEST}/ui" ] && [ ! -e "${APP_BASE}/ui" ]; then
        ln -s "${APP_DEST}/ui" "${APP_BASE}/ui" 2>/dev/null && echo "已创建 UI 软链接: ${APP_BASE}/ui" || true
    fi
done

# 2. 数据目录与默认配置
mkdir -p "${TRIM_PKGVAR}" 2>/dev/null || true
if [ ! -f "${TRIM_PKGVAR}/config.json" ]; then
    ( umask 077; echo "{\"interval\": 10, \"retention_days\": 7}" > "${TRIM_PKGVAR}/config.json" )
fi
chmod 600 "${TRIM_PKGVAR}/config.json" "${TRIM_PKGVAR}/sessions.json" 2>/dev/null || true

# 3. 可执行权限
chmod +x "${APP_DEST}/server.py" 2>/dev/null || true

# 4. 同步 manifest 到应用目录（取版本最高的一份，确保版本号正确）
first_mf=""; best_mf=""; best_ver=""
for APP_BASE in $BASES; do
    mf="${APP_BASE}/manifest"
    [ -f "$mf" ] || continue
    [ -n "$first_mf" ] || first_mf="$mf"
    v="$(sed -n 's/^[[:space:]]*version[[:space:]]*=[[:space:]]*"\?\([0-9][0-9.]*\)"\?.*/\1/p' "$mf" | head -n1)"
    [ -n "$v" ] || continue
    if [ -z "$best_mf" ] || [ "$(printf '%s\n%s\n' "$best_ver" "$v" | sort -V | tail -n1)" = "$v" ]; then
        best_mf="$mf"; best_ver="$v"
    fi
done
SRC_MF="${best_mf:-$first_mf}"
if [ -n "$SRC_MF" ]; then
    cp -f "$SRC_MF" "${APP_DEST}/manifest" 2>/dev/null || true
fi

echo "fnmonitor 安装完成"
exit 0
