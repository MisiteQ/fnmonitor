#!/bin/bash
# ============================================================
# fnmonitor - 飞牛监控 生命周期主脚本
# 用法: main {start|stop|restart|status|log [N]}
# 返回码: 0=成功/运行中  3=未运行  1=失败
# ============================================================
APP_NAME="${TRIM_APPNAME:-fnmonitor}"
PID_FILE="${TRIM_PKGVAR}/server.pid"
LOG_FILE="${TRIM_PKGVAR}/server.log"
APP_DIR="${TRIM_APPDEST}"
PORT="${TRIM_SERVICE_PORT:-8777}"
PYTHON="python3"
LOG_MAX_BYTES=5242880   # server.log 超过 5MB 时启动前轮转为 server.log.1

if [ -z "${TRIM_PKGVAR}" ] || [ -z "${APP_DIR}" ]; then
    echo "错误：TRIM_PKGVAR / TRIM_APPDEST 未设置" >&2
    exit 1
fi

# 应用中心会把本脚本的输出追加进应用日志：只记录启动 / 停止这类状态变化，带上时间
say() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*"
}

# PID 文件残留且 PID 已被系统复用时，不能凭 PID 文件就 kill：
# 必须确认该进程的命令行确实是本应用的 server.py
pid_is_ours() {
    local pid="$1"
    case "$pid" in ''|*[!0-9]*) return 1 ;; esac
    kill -0 "$pid" 2>/dev/null || return 1
    [ -r "/proc/$pid/cmdline" ] || return 0   # 非 Linux /proc 不可读时退回旧行为
    local cmd
    cmd=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)
    case "$cmd" in
        *server.py*"$TRIM_PKGVAR"*) return 0 ;;
    esac
    return 1
}

read_pid() {
    [ -f "$PID_FILE" ] || return 1
    tr -d '[:space:]' < "$PID_FILE"
}

is_running() {
    local pid
    pid=$(read_pid) || return 1
    pid_is_ours "$pid"
}

start() {
    if is_running; then
        exit 0   # 已在运行：幂等返回，不重复记日志
    fi
    mkdir -p "${TRIM_PKGVAR}" 2>/dev/null || true
    if [ ! -f "$APP_DIR/server.py" ]; then
        echo "错误：未找到 server.py（$APP_DIR/server.py）" > "$TRIM_TEMP_LOGFILE"
        exit 1
    fi
    if ! command -v "$PYTHON" >/dev/null 2>&1; then
        echo "错误：系统中未找到 python3，无法启动监控服务" > "$TRIM_TEMP_LOGFILE"
        exit 1
    fi
    cd "$APP_DIR" || { echo "错误：无法进入应用目录 $APP_DIR" > "$TRIM_TEMP_LOGFILE"; exit 1; }
    # 限制 glibc 多线程 malloc arena 数量（默认最多 8×核数）。Python 线程池服务在
    # 多核 NAS 上 RSS 常因 arena 碎片虚高到数百 MB，压到 2 后内存占用可下降数倍
    export MALLOC_ARENA_MAX=2
    if [ -f "$LOG_FILE" ] && [ "$(wc -c < "$LOG_FILE" 2>/dev/null || echo 0)" -gt "$LOG_MAX_BYTES" ]; then
        mv -f "$LOG_FILE" "$LOG_FILE.1" 2>/dev/null || : > "$LOG_FILE"
    fi
    nohup "$PYTHON" "$APP_DIR/server.py" --port "$PORT" --data-dir "$TRIM_PKGVAR" >> "$LOG_FILE" 2>&1 &
    echo $! > "$PID_FILE"
    sleep 1.5
    if is_running; then
        say "已启动 ${APP_NAME}${TRIM_APPVER:+ v$TRIM_APPVER}（端口 $PORT，pid $(read_pid)）"
        exit 0
    fi
    echo "错误：$APP_NAME 启动失败，请查看日志 $LOG_FILE" > "$TRIM_TEMP_LOGFILE"
    tail -n 20 "$LOG_FILE" >> "$TRIM_TEMP_LOGFILE" 2>/dev/null
    say "启动失败，详见 $LOG_FILE"
    rm -f "$PID_FILE"
    exit 1
}

stop() {
    if [ -f "$PID_FILE" ]; then
        local pid
        pid=$(read_pid)
        if pid_is_ours "$pid"; then
            kill -TERM "$pid" 2>/dev/null
            local i=0
            while kill -0 "$pid" 2>/dev/null && [ $i -lt 20 ]; do
                sleep 0.5
                i=$((i + 1))
            done
            if pid_is_ours "$pid"; then
                say "10 秒内未退出，强制结束"
                kill -KILL "$pid" 2>/dev/null
            fi
            say "已停止 ${APP_NAME}（pid $pid）"
        fi
        rm -f "$PID_FILE"
    fi
    return 0
}

# 应用中心会周期性调用 status，结果只看退出码：这里不能有任何输出，
# 否则每次轮询都会往应用日志追加一行（旧版本因此刷出成千上万行 "is running"）
status() {
    if is_running; then
        exit 0
    fi
    rm -f "$PID_FILE"
    exit 3
}

log() {
    if [ -f "$LOG_FILE" ]; then
        local n="${2:-100}"
        case "$n" in ''|*[!0-9]*) n=100 ;; esac
        tail -n "$n" "$LOG_FILE"
    else
        echo "暂无日志"
    fi
    exit 0
}

case "$1" in
    start)   start ;;
    stop)    stop ;;
    restart) say "重启 $APP_NAME"; stop; sleep 1; start ;;
    status)  status ;;
    log)     log "$@" ;;
    *)       echo "用法: $0 {start|stop|restart|status|log}"; exit 1 ;;
esac
