#!/bin/bash
# ============================================================
# fnmonitor 配置变更后处理（应用中心「配置」向导保存后调用）
# 把向导参数【合并】写入 config.json：只更新采集间隔 / 保留天数，保留其余全部配置
# （登录口令哈希、端口、数据目录、在线更新开关、功耗参数等）。server 会实时读取，无需重启。
#
# 忘记登录口令的恢复方法：SSH 登录 NAS，编辑 ${TRIM_PKGVAR}/config.json
# （通常为 /var/apps/fnmonitor/var/config.json），删除 "auth_password_hash" 一行
# （或把 "auth_enabled" 改为 0），然后在应用中心重启「飞牛监控」，再在局域网内
# 用 IP 地址打开面板重新设置口令。
# ============================================================
if [ -z "${TRIM_PKGVAR}" ]; then
    echo "错误：TRIM_PKGVAR 未设置，跳过配置写入"
    exit 1
fi
mkdir -p "${TRIM_PKGVAR}" 2>/dev/null || true
INTERVAL="${wizard_interval:-10}"
RETENTION="${wizard_retention:-7}"
if ! python3 - "${TRIM_PKGVAR}/config.json" "${INTERVAL}" "${RETENTION}" <<'PY'
import json, os, sys
path, interval, retention = sys.argv[1], sys.argv[2], sys.argv[3]


def to_int(v, default, lo, hi):
    try:
        return max(lo, min(hi, int(str(v).strip())))
    except Exception:
        return default


cfg = {}
try:
    with open(path, "r", encoding="utf-8", errors="ignore") as f:
        cfg = json.load(f)
    if not isinstance(cfg, dict):
        cfg = {}
except FileNotFoundError:
    cfg = {}
except Exception:
    # 现有文件损坏：先备份再重建，避免静默丢失
    try:
        os.replace(path, path + ".broken")
    except Exception:
        pass
    cfg = {}
cfg["interval"] = to_int(interval, 10, 2, 3600)
cfg["retention_days"] = to_int(retention, 7, 1, 365)
tmp = "%s.tmp.%d" % (path, os.getpid())
fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w", encoding="utf-8") as f:
    json.dump(cfg, f, ensure_ascii=False, indent=1)
    f.flush()
    os.fsync(f.fileno())
os.chmod(tmp, 0o600)
os.replace(tmp, path)
print("配置已更新：采集间隔 %ss，历史保留 %s 天" % (cfg["interval"], cfg["retention_days"]))
PY
then
    echo "错误：写入配置失败" > "${TRIM_TEMP_LOGFILE:-/dev/stderr}"
    exit 1
fi
exit 0
