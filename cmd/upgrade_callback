#!/bin/bash
# ============================================================
# fnmonitor 升级后处理
# 重新创建桌面 UI 软链接并修复可执行权限
# ============================================================
APP_BASE="/var/apps/${TRIM_APPNAME:-fnmonitor}"
APP_DEST="${TRIM_APPDEST}"
if [ -d "${APP_DEST}/ui" ] && [ ! -e "${APP_BASE}/ui" ]; then
    ln -s "${APP_DEST}/ui" "${APP_BASE}/ui" 2>/dev/null || true
fi
chmod +x "${APP_DEST}/server.py" 2>/dev/null || true
# 同步 manifest 到应用目录：fnOS 把顶层 manifest 放 /var/apps/，但 server.py
# 的 _read_manifest_version() 优先从 APP_DEST 读。若旧版 manifest 残留在此，
# 版本号会显示为旧值。此处用 /var/apps/ 的权威 manifest 覆盖。
if [ -f "${APP_BASE}/manifest" ]; then
    cp -f "${APP_BASE}/manifest" "${APP_DEST}/manifest" 2>/dev/null || true
fi
# 保持已有配置
mkdir -p "${TRIM_PKGVAR}" 2>/dev/null || true
if [ ! -f "${TRIM_PKGVAR}/config.json" ]; then
    echo "{\"interval\": 10, \"retention_days\": 7}" > "${TRIM_PKGVAR}/config.json"
fi
echo "fnmonitor 升级完成"
exit 0
